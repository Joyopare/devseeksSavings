{

    "builds": [
        {
        "src": "finance_savings/wsgi.py",
        "use": "@vercel/python",
        "config": { "maxLambdaSize": "15mb", "runtime": "python3.8" }
        }
    ],
    "routes": [
        {
        "src": "/(.*)",
        "dest": "/finance_savings/wsgi.py"
        }
    ]
}